# Copy to .env.local for local development. Never commit real values.

# --- Database -----------------------------------------------------------------
# Least-privilege application role (created by `npm run db:harden`). Used by the running app.
DATABASE_URL=postgres://moba_app:CHANGE_ME@localhost:55432/moba_election
# Owner role. Used ONLY by migrations / db:harden / admin bootstrap scripts. Never set this on Vercel.
DATABASE_OWNER_URL=postgres://moba:CHANGE_ME@localhost:55432/moba_election
# Password db:harden assigns to the moba_app role (high entropy; Neon requires >= 60 bits).
MOBA_APP_DB_PASSWORD=
# Optional: max connections per server instance (default 10; use 5 on Vercel).
DATABASE_POOL_MAX=

# --- Application ----------------------------------------------------------------
APP_URL=http://localhost:3000
# >= 32 random characters: openssl rand -base64 48
APP_SECRET=
# 32 random bytes, base64: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# --- Email (Resend) ----------------------------------------------------------------
# "resend" in production. "file" writes emails to ./.mail-outbox for local development only.
EMAIL_TRANSPORT=file
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="MOBA 2017 Elections <elections@your-verified-domain.org>"
EMAIL_REPLY_TO=

# --- Scheduled jobs -------------------------------------------------------------------
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET". >= 16 random characters.
CRON_SECRET=
